# Copy this file to .env and fill in real values.
# Never commit .env with real secrets.

# Required: Anthropic API key used by all agents (fix, chat, security, test, summary, quality)
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Optional: set to "1" to enable the full live pipeline run in tests/e2e_test.py
RUN_PIPELINE=0

# Optional: LangSmith tracing - set LANGCHAIN_TRACING_V2=true to enable.
# Every agent call and tool call will be traced under LANGCHAIN_PROJECT.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=YOUR_LANGSMITH_KEY_HERE
LANGCHAIN_PROJECT=codeguard

# ── v2: Postgres (docker-compose) ──────────────────────────────────────
# Consumed directly by the official postgres image to initialize the
# db service, and by docker-compose.yml's ${VAR} substitution to build
# DATABASE_URL for the api/worker containers. Change the password for
# anything beyond local dev.
POSTGRES_USER=codeguard
POSTGRES_PASSWORD=codeguard_dev_only
POSTGRES_DB=codeguard

# Required by codeguard.config.Settings. This is the HOST-facing value
# (for running codeguard directly on your machine, e.g. tests, against
# the dockerized Postgres via its mapped port). Inside docker-compose,
# the api/worker services override this to point at db:5432 instead —
# see docker-compose.yml. Do not change 5433 here unless you also
# change the port mapping in docker-compose.yml.
#
# Production (Phase 10): this points at Azure Database for PostgreSQL
# Flexible Server instead of the local container — a managed service,
# not a container. Phase 2's connection/pool code must be written
# against that assumption: enforce sslmode=require and respect the
# tier's max connection count, don't assume the unlimited local default.
DATABASE_URL=postgresql://codeguard:codeguard_dev_only@localhost:5433/codeguard

# Required by codeguard.config.Settings. Placeholders until Phase 1
# creates the real GitHub App and these get replaced with real values.
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET

# Path to the GitHub App's private key (.pem), downloaded once from the
# App's settings page. Never commit the key itself — only this path.
# The file must exist outside git; secrets/ is gitignored for exactly
# this. Used to sign the JWT that requests installation tokens.
GITHUB_PRIVATE_KEY_PATH=./secrets/codeguard.private-key.pem

# Dev-only tunnel relay (https://smee.io/new). NOT read by
# codeguard.config.Settings — this is purely a local convenience so
# `npx smee-client --url $SMEE_URL --target http://localhost:8000/webhook`
# has somewhere to read the channel from without hardcoding it in a
# shell command. Also set as the GitHub App's Webhook URL.
SMEE_URL=https://smee.io/YOUR_CHANNEL_ID
