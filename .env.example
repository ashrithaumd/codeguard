# Copy this file to .env and fill in real values.
# Never commit .env with real secrets.

# Required: Anthropic API key used by all agents (fix, chat, security, test, summary, quality)
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Optional: set to "1" to enable the full live pipeline run in tests/e2e_test.py
RUN_PIPELINE=0

# Optional: LangSmith tracing - set LANGCHAIN_TRACING_V2=true to enable.
# Every agent call and tool call will be traced under LANGCHAIN_PROJECT.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=YOUR_LANGSMITH_KEY_HERE
LANGCHAIN_PROJECT=codeguard
