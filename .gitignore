# Secrets and environment
.env
.streamlit/secrets.toml
secrets/
# Phase 10 incident: a *.tmp file materializing a secret got its full
# contents echoed back into the assistant's context via this session's
# file-change notifications. Never materialize a secret into a file
# again (temp or otherwise) — this is a backstop, not the actual fix.
*.tmp

# Database files
*.db
*.sqlite
*.sqlite3

# Python virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local deploy transcripts (deploy/azure.sh output) — build logs, not
# artifacts, and they pick up whatever az/docker print.
deploy_output.log

# Prometheus bearer token for the Azure /metrics scrape target.
observability/metrics-token
